# Copy to .env and fill in for local/Docker use. No Firebase secrets are needed here --
# the backend verifies Firebase ID tokens using Google's public JWKS, not a service account.

# Used directly by the server (Docker Compose injects the same values into the postgres
# container -- keep POSTGRES_* and DB_* in sync if you change them).
DB_URL=postgres://ide:ide@db:5432/ide

POSTGRES_USER=ide
POSTGRES_PASSWORD=ide
POSTGRES_DB=ide

PORT=5000
